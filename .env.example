# ─── LLM Provider ────────────────────────────────────────────────────────────
LLM_PROVIDER=google

# Google Gemini (default) — https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI — https://platform.openai.com/api-keys
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# Anthropic — https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Groq — https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# ─── Resume ──────────────────────────────────────────────────────────────────
CV_PATH=resumes/my_resume.pdf
# CV_PATH1=   # second resume if you have multiple
# CV_PATH2=

# ─── Browser ─────────────────────────────────────────────────────────────────
# Ubuntu default: chromium (headless). Change to chrome if system Chrome installed.
BROWSER_CHANNEL=chromium
BROWSER_HEADLESS=true
# Override profile dir if needed:
# BROWSER_USER_DATA_DIR=

# ─── Job Search Settings ─────────────────────────────────────────────────────
MIN_FIT_SCORE=0.65          # auto-apply threshold
DRY_RUN=false               # set to true to test without submitting

# ─── Platform Credentials ────────────────────────────────────────────────────
# Leave blank to skip that platform.

INTERNSHALA_EMAIL=
INTERNSHALA_PASSWORD=

NAUKRI_EMAIL=
NAUKRI_PASSWORD=

WELLFOUND_EMAIL=
WELLFOUND_PASSWORD=

CUTSHORT_EMAIL=
CUTSHORT_PASSWORD=

INDEED_EMAIL=
INDEED_PASSWORD=

# LinkedIn is NEVER auto-applied. Leave blank — it's scrape-only.
# Provide credentials only if you want LinkedIn scraping to work.
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
